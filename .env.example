# Konfiguration für das Server-Deployment (docker-compose.server.yml).
# Kopieren nach .env und anpassen. Die .env selbst gehört nicht ins Repository.

# Wo der Webdienst im Netz erreichbar ist.
# WEB_BIND=127.0.0.1 -> nur lokal; für LAN-Zugriff die IP des Servers eintragen.
WEB_BIND=127.0.0.1
WEB_PORT=9640

# Routing. Standard ist der lokale BRouter-Container aus dem Compose.
# Nur zum Ausprobieren ohne eigene Kacheln: https://brouter.de/brouter
BROUTER_URL=http://brouter:17777/brouter

# Profile hochladen? Der eigene Container hat sie schon (dann false).
# Für eine fremde/öffentliche Instanz auf true setzen.
BROUTER_UPLOAD_PROFILES=false

# Offene Dienste
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
AUTOBAHN_URL=https://verkehr.autobahn.de/o/autobahn

# Startansicht der Karte, solange keine Wegpunkte gesetzt sind.
# Format "lng,lat"; Zoom 0 (Welt) bis 22 (Straße). Leer = Default (Bilbao, 10).
VITE_MAP_CENTER=-2.935,43.263
VITE_MAP_ZOOM=10

# Echte Kontaktadresse für den User-Agent (Fair Use bei OSM-Diensten).
# Nominatim blockt Platzhalter wie example.com und antwortet dann mit 403.
CONTACT_EMAIL=

# Servidor MCP (planificación de rutas para agentes).
# Dirección y puerto de publicación; PUBLIC_WEB_URL es la base de los enlaces
# que devuelve, así que debe ser la URL con la que tú abres la web.
MCP_BIND=127.0.0.1
MCP_PORT_HOST=9641
PUBLIC_WEB_URL=http://127.0.0.1:9640
# Zeitlimit je Backend-Aufruf in Millisekunden (1000-600000).
ROUTE_TIMEOUT_MS=180000
# Obergrenze der Wegpunkte je Route (2-25). Jeder Abschnitt kostet drei BRouter-Aufrufe.
MCP_MAX_POINTS=10

# Fichero de la base de datos de rutas guardadas, dentro del contenedor.
# IMPORTANTE: el directorio del anfitrión debe existir y pertenecer al uid 1000
# ANTES del primer arranque, porque el backend no corre como root:
#   mkdir -p ./data/routes && sudo chown 1000:1000 ./data/routes
# Si Docker lo crea primero, será de root y /api/routes responderá 503.
ROUTES_DB_PATH=/data/routes.db
